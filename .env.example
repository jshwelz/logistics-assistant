# OpenAI-compatible adapter pointed at Gemini's free API.
# Copy to .env and set PROVIDER_API_KEY. .env is gitignored.
# Do not put a key in this file. The stack stays on the fake provider when these are unset.
# provider name "openai" is the existing HTTP adapter, not the OpenAI service.

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
ANSWER_PROVIDER=openai
ANSWER_MODEL=gemini-3.5-flash-lite
PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
PROVIDER_API_KEY=
